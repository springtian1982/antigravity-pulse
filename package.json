{
  "name": "antigravity-pulse",
  "version": "0.1.0",
  "description": "Real-time active model indicator, multi-agent topology HUD, and quota telemetry plugin & CLI for Google Antigravity 2.0.",
  "author": "springtian <springtian@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/springtian1982/antigravity-pulse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springtian1982/antigravity-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/springtian1982/antigravity-pulse/issues"
  },
  "keywords": [
    "antigravity",
    "agy",
    "observability",
    "telemetry",
    "model-monitor",
    "multi-agent",
    "subagent",
    "swarm",
    "flexoki",
    "mcp",
    "sidecar",
    "cli"
  ],
  "type": "module",
  "bin": {
    "agy-pulse": "./dist/cli.cjs"
  },
  "files": [
    "plugin.json",
    "hooks.json",
    "mcp_config.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/",
    "bin/",
    "dist/",
    "sidecars/",
    "skills/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/build-tests.mjs && node --test .test-dist/*.test.cjs",
    "install:global": "node scripts/install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
